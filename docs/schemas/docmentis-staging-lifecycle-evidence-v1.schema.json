{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quata.invalid/schemas/docmentis-staging-lifecycle-evidence-v1.schema.json",
  "title": "Quata DocMentis staging lifecycle evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "transcripts"],
  "properties": {
    "schemaVersion": {
      "const": "quata.docmentis-staging-lifecycle-evidence/v1"
    },
    "transcripts": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "allOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["fixtureId", "format", "events"],
            "properties": {
              "fixtureId": {
                "enum": ["staging-pdf", "staging-docx", "staging-pptx", "staging-xlsx"]
              },
              "format": {
                "enum": ["PDF", "DOCX", "PPTX", "XLSX"]
              },
              "events": {
                "type": "array",
                "minItems": 5,
                "maxItems": 5,
                "prefixItems": [
                  { "$ref": "#/$defs/documentLoad" },
                  { "$ref": "#/$defs/customPageOverlay" },
                  { "$ref": "#/$defs/isLoaded" },
                  { "$ref": "#/$defs/pageCount" },
                  { "$ref": "#/$defs/cleanup" }
                ],
                "items": false
              }
            }
          },
          {
            "oneOf": [
              {
                "properties": {
                  "fixtureId": { "const": "staging-pdf" },
                  "format": { "const": "PDF" }
                }
              },
              {
                "properties": {
                  "fixtureId": { "const": "staging-docx" },
                  "format": { "const": "DOCX" }
                }
              },
              {
                "properties": {
                  "fixtureId": { "const": "staging-pptx" },
                  "format": { "const": "PPTX" }
                }
              },
              {
                "properties": {
                  "fixtureId": { "const": "staging-xlsx" },
                  "format": { "const": "XLSX" }
                }
              }
            ]
          }
        ]
      }
    }
  },
  "$defs": {
    "documentLoad": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "sequence"],
      "properties": {
        "type": { "const": "document:load" },
        "sequence": { "const": 1 }
      }
    },
    "customPageOverlay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "sequence"],
      "properties": {
        "type": { "const": "customPageOverlay" },
        "sequence": { "const": 2 }
      }
    },
    "isLoaded": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "sequence", "value"],
      "properties": {
        "type": { "const": "isLoaded" },
        "sequence": { "const": 3 },
        "value": { "const": true }
      }
    },
    "pageCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "sequence", "value"],
      "properties": {
        "type": { "const": "pageCount" },
        "sequence": { "const": 4 },
        "value": { "type": "integer", "minimum": 1 }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "sequence"],
      "properties": {
        "type": { "const": "cleanup" },
        "sequence": { "const": 5 }
      }
    }
  }
}
