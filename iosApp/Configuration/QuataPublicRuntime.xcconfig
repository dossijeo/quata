// Public client-runtime defaults. Deployment values belong only in the ignored
// QuataPublicRuntime.local.xcconfig; a missing value must leave the host inert.
QUATA_SUPABASE_URL =
QUATA_SUPABASE_PUBLISHABLE_KEY =
QUATA_IOS_REGISTRATION_API_KEY =
QUATA_IOS_REGISTRATION_CLIENT_INSTANCE_ID =
QUATA_IOS_REGISTRATION_CHALLENGE_TOKEN =

// Registration is deliberately opt-in even if a local file is present.
QUATA_IOS_REGISTRATION_ENABLED = false

// The ? form keeps a clean checkout buildable without a local runtime file.
#include? "QuataPublicRuntime.local.xcconfig"
